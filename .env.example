# Copy to .env and fill in local values. Never commit .env.
# Placeholder values only. Variable names may be refined during M1.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — restricted runtime account (must not own tables or bypass RLS)
DB_NAME=tracker
DB_HOST=localhost
DB_PORT=5432
DB_APP_USER=tracker_app
DB_APP_PASSWORD=change-me

# PostgreSQL — migration/owner account (used only for migrations)
DB_OWNER_USER=tracker_owner
DB_OWNER_PASSWORD=change-me

# Gemini (AI milestone only; leave empty until then)
GEMINI_API_KEY=
AI_MODEL=
